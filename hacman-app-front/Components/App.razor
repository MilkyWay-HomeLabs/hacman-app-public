<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    @inject IConfiguration Config
    @{
        var basePath = Config["AppBasePath"] ?? "/hacman/app";
        if (!basePath.EndsWith("/")) basePath += "/";
    }
    <base href="@basePath" />
    <meta name="hacman-api-base-url" content="@(Config["HacmanApiBaseUrl"]?.TrimEnd('/') ?? "https://milkyway.test/hacman/api")" />
    <meta name="nebula-login-url" content="@(Config["NebulaApi:LoginUrl"] ?? "https://milkyway.test/nebula/app/redirect?destination=Hacman")" />
    <meta name="max-redirect-attempts" content="@(Config["MaxRedirectAttempts"] ?? "2")" />
    <ResourcePreloader/>
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="app.css"/>
    <link rel="stylesheet" href="css/matrix.css"/>
    <link rel="stylesheet" href="hacman-app-front.styles.css"/>
    <ImportMap/>
    <link rel="icon" type="image/svg+xml" href="favicon.svg"/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet/>
    <title>Hacman User Panel</title>
</head>

<body>
<Routes @rendermode="InteractiveServer"/>

<!-- Custom non-blocking reconnect indicator. Replaces Blazor's default full-page overlay.
     Shown as a small bottom banner instead of blocking the entire page content. -->
<div id="components-reconnect-modal">
    <span>↻ RECONNECTING TO SERVER...</span>
</div>

<script src="_framework/blazor.web.js"></script>
<script src="js/localstorage.js"></script>
<script src="js/app.js"></script>
</body>

</html>