<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Version>1.0.0</Version>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>hacman_app_front</RootNamespace>
        <AssemblyName>$(AssemblyName.Replace(' ', '_'))</AssemblyName>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <UserSecretsId>b4f86435-8215-4587-aca3-0ed1a4d708ec</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DotNetEnv" Version="3.1.0" />
    </ItemGroup>

    <ItemGroup>
        <_ContentIncludedByDefault Remove="hacman-app-front\appsettings.Development.json" />
        <_ContentIncludedByDefault Remove="hacman-app-front\appsettings.json" />
        <_ContentIncludedByDefault Remove="hacman-app-front\Properties\launchSettings.json" />
        <_ContentIncludedByDefault Remove="hacman-app-front\Components\App.razor" />
        <_ContentIncludedByDefault Remove="hacman-app-front\Components\Layout\MainLayout.razor" />
        <_ContentIncludedByDefault Remove="hacman-app-front\Components\Layout\NavMenu.razor" />
        <_ContentIncludedByDefault Remove="hacman-app-front\Components\Pages\Error.razor" />
        <_ContentIncludedByDefault Remove="hacman-app-front\Components\Pages\Home.razor" />
        <_ContentIncludedByDefault Remove="hacman-app-front\Components\Pages\NotFound.razor" />
        <_ContentIncludedByDefault Remove="hacman-app-front\Components\Pages\Weather.razor" />
        <_ContentIncludedByDefault Remove="hacman-app-front\Components\Routes.razor" />
        <_ContentIncludedByDefault Remove="hacman-app-front\Components\_Imports.razor" />
        <_ContentIncludedByDefault Remove="hacman-app-front.Client\wwwroot\appsettings.Development.json" />
        <_ContentIncludedByDefault Remove="hacman-app-front.Client\wwwroot\appsettings.json" />
        <_ContentIncludedByDefault Remove="hacman-app-front.Client\Pages\Counter.razor" />
        <_ContentIncludedByDefault Remove="hacman-app-front.Client\_Imports.razor" />
        <_ContentIncludedByDefault Remove="Components\Themes\Book.razor" />
        <_ContentIncludedByDefault Remove="Components\Themes\Character.razor" />
        <_ContentIncludedByDefault Remove="Components\Themes\Cosplay.razor" />
        <_ContentIncludedByDefault Remove="Components\Themes\Error.razor" />
        <_ContentIncludedByDefault Remove="Components\Themes\Gallery.razor" />
        <_ContentIncludedByDefault Remove="Components\Themes\Home.razor" />
        <_ContentIncludedByDefault Remove="Components\Themes\NotFound.razor" />
        <_ContentIncludedByDefault Remove="Components\Themes\Weather.razor" />
    </ItemGroup>

</Project>