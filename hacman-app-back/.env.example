ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5432;Database=hacman;Username=postgres;Password=postgres

# Nebula achievements-ingestion service token (source=hacman), minted via
# POST {nebula-base}/api/v1/admin/achievement-tokens {"source":"hacman"}.
# Consumed by NebulaAchievementClient. Left unset or at CHANGE_ME, the Nebula
# adapter no-ops rather than erroring.
NEBULA_ACHIEVEMENTS_TOKEN=CHANGE_ME

# Base URL of nebula-rest-api's public API — never hardcode a specific environment's
# host. Left at CHANGE_ME (or empty), the Nebula adapter no-ops rather than erroring.
NEBULA_ACHIEVEMENTS_URL=CHANGE_ME

# Mirrors the GitHub Actions secret .github/workflows/backend-cicd.yml's "Run tests" step
# reads to populate ConnectionStrings__Default for CI test runs. Not read by the app
# itself; documented here so the secret's expected value is discoverable without reading
# the workflow YAML. Same value as ConnectionStrings__Default above, just under the name
# the GitHub secret uses.
HACMAN_BACKEND_CONNECTIONSTRINGS__DEFAULT=CHANGE_ME
